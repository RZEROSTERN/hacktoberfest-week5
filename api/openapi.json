{
  "openapi": "3.1.0",
  "info": {
    "title": "The Last Candle local API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Report process readiness without loading or contacting a model.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/prepare": {
      "post": {
        "summary": "Prepare",
        "description": "Prepare an installed, selected model or explicitly enter fallback mode.",
        "operationId": "prepare",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/dialogue": {
      "post": {
        "summary": "Dialogue",
        "description": "Resolve an authored reply; model output is never returned to the player.",
        "operationId": "dialogue",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DialogueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DialogueRequest": {
        "properties": {
          "object_id": {
            "type": "string",
            "title": "Object Id"
          },
          "recovered": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Recovered"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Language"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_id",
          "recovered",
          "language",
          "message"
        ],
        "title": "DialogueRequest"
      },
      "DialogueResponse": {
        "properties": {
          "relevant": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevant"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used"
          }
        },
        "type": "object",
        "required": [
          "relevant",
          "reply",
          "fallback_used"
        ],
        "title": "DialogueResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "Readiness": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "ready",
              "fallback"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "Readiness"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
